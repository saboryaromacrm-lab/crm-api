# Copiá este archivo a `.env` y ajustá los valores.

# Conexión a PostgreSQL (local por defecto).
# Formato: postgres://USUARIO:PASSWORD@HOST:PUERTO/BASE
DATABASE_URL=postgres://postgres:postgres@localhost:5432/crm

# Puerto en el que escucha la API.
PORT=3001

# Interfaz en la que escucha.
#   0.0.0.0   (default) toda la red — necesario en el LOCAL: la sync de coffit
#             y las cajas consumen la API desde otras máquinas.
#   127.0.0.1 solo localhost — OBLIGATORIO en el VPS, donde nginx es la única
#             puerta. Ver deploy/DEPLOY.md.
HOST=0.0.0.0

# Orígenes permitidos por CORS (coma-separados). El dev del CRM corre en :3000.
# En el VPS el dashboard sale del MISMO origen que la API (nginx la publica en
# /api), así que acá solo van los clientes externos, si hay.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
