# Copiá este archivo a `.env` y ajustá los valores.

# Conexión a PostgreSQL (local por defecto).
# Formato: postgres://USUARIO:PASSWORD@HOST:PUERTO/BASE
DATABASE_URL=postgres://postgres:postgres@localhost:5432/crm

# Puerto en el que escucha la API.
PORT=3001

# Orígenes permitidos por CORS (coma-separados). El dev del CRM corre en :3000.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
