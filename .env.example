# Copiá este archivo a `.env` y ajustá los valores.

# Conexión a PostgreSQL (local por defecto).
# Formato: postgres://USUARIO:PASSWORD@HOST:PUERTO/BASE
DATABASE_URL=postgres://postgres:postgres@localhost:5432/crm

# Puerto en el que escucha la API.
PORT=3001

# Interfaz en la que escucha.
#   0.0.0.0   (default) toda la red — necesario en el LOCAL: la sync de coffit
#             y las cajas consumen la API desde otras máquinas.
#   127.0.0.1 solo localhost — OBLIGATORIO en el VPS, donde nginx es la única
#             puerta. Ver deploy/DEPLOY.md.
HOST=0.0.0.0

# Orígenes permitidos por CORS (coma-separados). El dev del CRM corre en :3000.
# En el VPS el dashboard sale del MISMO origen que la API (nginx la publica en
# /api), así que acá solo van los clientes externos, si hay.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Clave de servicio de COFFIT, para `GET /api/cafeteria/sync`.
#
# Coffit es otro sistema, no una persona: no tiene sesión ni contraseña. Hasta
# ahora se autenticaba con un token de sesión común del CRM guardado en su
# configuración, y ese token no es "solo lectura de envíos" — es el panel
# entero, con el que se mueve stock.
#
# Con esta variable cargada, coffit manda el secreto en la cabecera
# `X-Clave-Servicio` y NO necesita ninguna cuenta del CRM. Solo abre ese
# endpoint; cualquier otra ruta le sigue pidiendo sesión.
#
# SIN cargar (el default), la puerta no existe y `sync` pide sesión como antes,
# así que se puede activar el día que se coordine con coffit sin romper nada.
# Generá algo largo y al azar, por ejemplo:  openssl rand -hex 32
# COFFIT_TOKEN=
