# Copiá este archivo a `.env` y ajustá los valores.

# Conexión a PostgreSQL (local por defecto).
# Formato: postgres://USUARIO:PASSWORD@HOST:PUERTO/BASE
DATABASE_URL=postgres://postgres:postgres@localhost:5432/crm

# Puerto en el que escucha la API.
PORT=3001

# Interfaz en la que escucha.
#   0.0.0.0   (default) toda la red. Necesario en el LOCAL —la sync de coffit y
#             las cajas consumen la API desde otras máquinas— y también EN
#             DOCKER, donde el contenedor tiene su propia red y Traefik no
#             podría alcanzarlo si escuchara solo en su localhost.
#   127.0.0.1 solo localhost. Va cuando Node corre como proceso del HOST con
#             nginx delante: ahí es lo que impide que se le hable directo.
# Ver deploy/DEPLOY.md: en Docker lo que cierra la puerta no es esta variable
# sino no publicar el puerto del contenedor.
HOST=0.0.0.0

# Zona horaria del proceso. NO es cosmético: el sistema decide "qué vence hoy" y
# "cuántos días faltan" con la fecha del proceso. Un VPS nuevo corre en UTC, y
# ahí, pasadas las 21:00 hora argentina, "hoy" ya es mañana para el servidor:
# lo que vence hoy aparece como vencido y el contador del sidebar cuenta de más.
TZ=America/Argentina/Buenos_Aires

# En quién confía Express para saber la IP real del visitante (de ahí salen el
# cupo de la tienda y el freno de intentos del login).
#   loopback  (default) nginx en la MISMA máquina. Pide HOST=127.0.0.1.
#   1         Docker/Dokploy: el proxy es Traefik, que es otro contenedor y NO
#             es loopback. Válido SOLO si el puerto del contenedor no se
#             publica al host — si se publica, el encabezado se puede falsificar.
# Nunca `true`: eso le cree al primer valor de la cadena, que lo escribe el
# cliente. El razonamiento completo está en src/main.ts.
TRUST_PROXY=loopback

# Orígenes permitidos por CORS (coma-separados). El dev del CRM corre en :3000.
# En el VPS el dashboard sale del MISMO origen que la API (nginx la publica en
# /api), así que acá solo van los clientes externos, si hay.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Clave de servicio de COFFIT, para `GET /api/cafeteria/sync`.
#
# Coffit es otro sistema, no una persona: no tiene sesión ni contraseña. Hasta
# ahora se autenticaba con un token de sesión común del CRM guardado en su
# configuración, y ese token no es "solo lectura de envíos" — es el panel
# entero, con el que se mueve stock.
#
# Con esta variable cargada, coffit manda el secreto en la cabecera
# `X-Clave-Servicio` y NO necesita ninguna cuenta del CRM. Solo abre ese
# endpoint; cualquier otra ruta le sigue pidiendo sesión.
#
# SIN cargar (el default), la puerta no existe y `sync` pide sesión como antes,
# así que se puede activar el día que se coordine con coffit sin romper nada.
# Generá algo largo y al azar, por ejemplo:  openssl rand -hex 32
# COFFIT_TOKEN=
